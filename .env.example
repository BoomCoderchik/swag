# Swag — конфигурация. Скопируй в .env и заполни. НЕ коммитить .env!

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# @username канала или chat_id (бот должен быть админом канала)
CHANNEL_ID=

# --- GitHub (опционально, повышает лимит Search API с 10 до 30 req/мин) ---
GITHUB_TOKEN=

# --- Режим ---
# Интервал опроса источников, минуты
POLL_INTERVAL_MIN=30
# Путь к базе дедупликации
DB_PATH=data/swag.db
# Часовой пояс планировщика
TIMEZONE=Europe/Moscow
# 1 = не постить в канал, печатать посты в консоль (для разработки)
DRY_RUN=1

# --- Фаза 2 (пока не используется) ---
# Ключ Gemini AI Studio (проект БЕЗ биллинга = free tier)
# GEMINI_API_KEY=
