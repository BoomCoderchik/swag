# Swag — конфигурация. Скопируй в .env и заполни. НЕ коммитить .env!

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# @username канала или chat_id (бот должен быть админом канала)
CHANNEL_ID=

# --- Режим ---
# Интервал опроса источников, минуты
POLL_INTERVAL_MIN=30
# Свежесть новости: постить только публикации младше N часов
FRESH_HOURS=48
# Максимум постов за один цикл (защита от флуда в канале)
MAX_POSTS_PER_CYCLE=15
# Путь к базе дедупликации
DB_PATH=data/swag.db
# Часовой пояс планировщика
TIMEZONE=Europe/Moscow
# 1 = не постить в канал, печатать посты в консоль (для разработки)
DRY_RUN=1

# --- Gemini (рекомендуется): умный фильтр релевантности + русский перевод постов ---
# Бесплатный ключ: https://aistudio.google.com (проект БЕЗ биллинга = free tier)
# Без ключа работает строгий ключевый фильтр, посты идут без перевода
GEMINI_API_KEY=
# Модель Gemini (можно не менять)
GEMINI_MODEL=gemini-flash-latest
